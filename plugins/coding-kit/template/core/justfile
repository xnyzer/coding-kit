# {{PROJECT_NAME}} — standard recipes
# Docs-only default: a stack module replaces this file with real implementations.
# The recipe set (setup/dev/test/lint/format/check/build/features-index/bump-tools) is
# the stable contract — skills and CI call only these names.

default:
    @just --list

# Install dependencies + git hooks
setup:
    lefthook install

# Run the project locally
dev:
    @echo "docs-only: nothing to run — add a stack module via /choose-stack."

# Run the test suite
test:
    @echo "docs-only: no tests configured."

# Static analysis
lint:
    @echo "docs-only: no linter configured."

# Auto-format the codebase
format:
    @echo "docs-only: nothing to format."

# Regenerate the table of all features in features/INDEX.md
features-index:
    sh scripts/features-index.sh write

# Raise each tool in mise.lock to the newest version of its major; Renovate does the
# same weekly where it runs and may execute mise.
bump-tools:
    mise lock --bump

# Full gate — must be green before every commit
check:
    sh scripts/features-index.sh check
    @echo "docs-only: no code checks configured."

# Production build
build:
    @echo "docs-only: nothing to build."
