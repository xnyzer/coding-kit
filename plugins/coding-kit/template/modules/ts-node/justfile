# {{PROJECT_NAME}} — standard recipes (ts-node module)

default:
    @just --list

# Install dependencies + git hooks
setup:
    pnpm install
    lefthook install

# Run the project locally
dev:
    @echo "ts-node module: wire your dev entrypoint here (e.g. node --watch dist/index.js after a build)."

# Run the test suite
test:
    pnpm exec vitest run

# Static analysis: Biome (format + lint, zero warnings) and the type checker
lint:
    pnpm exec biome ci --error-on-warnings .
    pnpm exec tsc --noEmit

# Auto-format + safe lint fixes (incl. import organizing)
format:
    pnpm exec biome check --write .

# Regenerate the table of all features in features/INDEX.md
features-index:
    sh scripts/features-index.sh write

# Raise each tool in mise.lock to the newest version of its major; Renovate does the
# same weekly where it runs and may execute mise.
bump-tools:
    mise lock --bump

# Full gate — must be green before every commit
check: lint test
    sh scripts/features-index.sh check
    just license-check

# License gate (part of check): every runtime dependency's license must be allowed in
# license-policy.txt. pnpm lists the `dependencies` with their licenses; devDependencies
# and the project itself stay out. Without runtime dependencies pnpm 12 prints `{}`, while
# pnpm 11 prints a sentence instead of JSON — both mean an empty list.
license-check:
    #!/bin/sh
    set -eu
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    pnpm licenses list --prod --json > "$tmp/licenses.json"
    node -e '
      const fs = require("node:fs");
      const text = fs.readFileSync(process.argv[1], "utf8").trim();
      if (text === "No licenses in packages found") process.exit(0);
      for (const [license, packages] of Object.entries(JSON.parse(text))) {
        for (const p of packages) console.log(p.name + "\t" + license.replace(/\s+/g, " "));
      }
    ' "$tmp/licenses.json" > "$tmp/licenses.tsv"
    sh scripts/license-check.sh "$tmp/licenses.tsv"

# Production build (tests excluded via tsconfig.build.json)
build:
    pnpm exec tsc -p tsconfig.build.json
